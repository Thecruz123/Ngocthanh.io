<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NgocThanh.io.vn</title>

<style>
body{
    font-family:-apple-system,sans-serif;
    background:#eef2f7;
    margin:0;
    text-align:center;
}

.container{
    max-width:420px;
    margin:auto;
    padding:20px;
}

/* AVATAR KHÔNG BỊ CẮT */
.avatar{
    width:120px;
    height:120px;
    border-radius:50%;
    background:#fff;
    padding:5px;
    margin:auto;
}

.avatar img{
    width:100%;
    height:100%;
    object-fit:contain;
    border-radius:50%;
}

.name{
    font-size:26px;
    font-weight:bold;
    margin-top:10px;
}

.card{
    background:#fff;
    padding:20px;
    border-radius:20px;
    margin-top:20px;
    box-shadow:0 10px 20px rgba(0,0,0,0.1);
}

.btn{
    display:block;
    background:#4da3ff;
    color:white;
    padding:12px;
    border-radius:12px;
    margin-top:10px;
    text-decoration:none;
}

img{
    width:100%;
    border-radius:15px;
}

.hidden{
    display:none;
}
</style>
</head>

<body>

<div class="container">

    <!-- AVATAR -->
    <div class="avatar">
        <img src="avatar.jpeg">
    </div>

    <div class="name">Phạm Ngọc Thanh ✔️</div>

    <!-- FACEBOOK -->
    <a href="https://www.facebook.com/share/1HCWzLwCC1/?mibextid=wwXIfr" class="btn">
        👉 Facebook của tôi
    </a>

    <!-- SPOTIFY -->
    <div class="card">
        <h3>Mua Spotify Vĩnh Viễn</h3>

        <!-- ẢNH SPOTIFY -->
        <img src="spotify.jpg" onclick="showQR('spotify')">

        <!-- QR -->
        <img id="spotifyQR" class="hidden" src="qr.jpg">

        <p>Quét QR và chờ admin duyệt</p>

        <!-- LINK -->
        <a id="spotifyLink" href="Spotify.ipa" class="btn hidden">
            ⬇ Tải Spotify
        </a>
    </div>

    <!-- LOCKET -->
    <div class="card">
        <h3>Mua Locket Gold 10s Giá Rẻ</h3>

        <!-- ẢNH LOCKET -->
        <img src="locket.jpg" onclick="showQR('locket')">

        <!-- QR -->
        <img id="locketQR" class="hidden" src="qr.jpg">

        <p>Quét QR và chờ admin duyệt</p>

        <!-- LINK -->
        <a id="locketLink" href="Locket.ipa" class="btn hidden">
            ⬇ Tải Locket
        </a>
    </div>

</div>

<script>
// CLICK HIỆN QR
function showQR(type){
    if(type === "spotify"){
        document.getElementById("spotifyQR").classList.remove("hidden");
    }
    if(type === "locket"){
        document.getElementById("locketQR").classList.remove("hidden");
    }
}

// ADMIN DUYỆT
const url = new URLSearchParams(window.location.search);

if(url.get("admin") === "ok"){
    document.getElementById("spotifyLink").classList.remove("hidden");
    document.getElementById("locketLink").classList.remove("hidden");
}
</script>

</body>
</html>
  <img src="https://i.imgur.com/abc123.jpg">
